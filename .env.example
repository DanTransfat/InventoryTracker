# Copy to .env and adjust. Never commit the real .env (it is git-ignored).
# The same file is read by Docker Compose, the Flask backend and the Vite dev server.

# --- MySQL (used by docker compose to create the database and user) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=change-me
# Host port for MySQL. 3307 avoids clashing with a MySQL you may already run on 3306.
MYSQL_PORT=3307

# --- Backend ---
# For running the backend on your machine (outside Docker). Inside Docker Compose this is
# overridden to point at the "mysql" service.
DATABASE_URL=mysql://inventory:change-me@127.0.0.1:3307/inventory
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
# "log" writes a line to the backend log when an alert opens; "webhook" POSTs JSON to ALERT_WEBHOOK_URL.
ALERT_NOTIFIER=log
ALERT_WEBHOOK_URL=

# --- Frontend ---
# Port for the Vite dev server, and where it forwards /api calls.
FRONTEND_PORT=5173
VITE_PROXY_TARGET=http://localhost:8000
# Host port for the production frontend container (nginx) in Docker Compose.
WEB_PORT=8080
