# SITE_ADDRESS comes from the environment (docker-compose.prod.yml).
# A hostname gets automatic HTTPS, and HTTP requests are redirected to it.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy frontend:80
}
